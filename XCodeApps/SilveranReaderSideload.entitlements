<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Group only — never keychain-access-groups / KEYCHAIN_ACCESS_GROUP on Sideload.
	     Literal id (not $(APP_GROUP_ID)): unsigned package-ipa skips entitlement expansion;
	     AltStore must resign with the real group string. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.punkrally.reader</string>
	</array>
</dict>
</plist>
